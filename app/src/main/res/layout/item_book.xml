<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_item_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên sách"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Author -->
    <TextView
        android:id="@+id/tvBookAuthor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tác giả: Nguyễn Văn A"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Badges and Rating Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- Category Tag -->
            <TextView
                android:id="@+id/tvCategoryTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_category"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Công nghệ"
                android:textColor="@color/primary_teal"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Status Tag -->
            <TextView
                android:id="@+id/tvStatusTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_status_reading"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Đang đọc"
                android:textColor="@color/orange_status"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- RatingBar -->
        <RatingBar
            android:id="@+id/rbItemRating"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:isIndicator="true"
            android:numStars="5"
            android:progressTint="#FFC107"
            android:progressBackgroundTint="#CCCCCC"
            android:rating="4.0"
            android:stepSize="1.0" />

    </RelativeLayout>

</LinearLayout>
